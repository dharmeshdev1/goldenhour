{
  "name": "goldenhour-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/fixtures.mjs use && node scripts/copy-duckdb.mjs && next dev",
    "build": "node scripts/fixtures.mjs clean && node scripts/copy-duckdb.mjs && next build && node scripts/fixtures.mjs check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.ts",
    "fixtures:use": "node scripts/fixtures.mjs use",
    "fixtures:clean": "node scripts/fixtures.mjs clean"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource-variable/geist-mono": "5.2.7",
    "@fontsource-variable/instrument-sans": "5.2.8",
    "@fontsource/instrument-serif": "5.2.8",
    "d3-force": "3.0.1",
    "d3-sankey": "0.12.3",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "graphology": "0.26.0",
    "gsap": "3.15.0",
    "motion": "14.9.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sigma": "3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/d3-force": "3.0.10",
    "@types/d3-sankey": "0.12.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "graphology-types": "0.24.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
